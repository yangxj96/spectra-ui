{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Web 管理后台 · pnpm start（mise）",
            "type": "process",
            "command": "mise.exe",
            "args": ["exec", "--", "pnpm", "start"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Web 管理后台 · Vite（mise · 快速）",
            "type": "process",
            "command": "mise.exe",
            "args": ["exec", "--", "pnpm", "exec", "vite"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
