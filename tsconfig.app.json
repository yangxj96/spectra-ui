{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["src/**/*", "src/env.d.ts", "types/**/*.d.ts", "tests/**/*"],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "paths": {
            "@/*": ["./src/*"],
            "@yangxj96/logicflow-plugin-flowable": ["../logicflow-plugin-flowable/src/index.ts"],
            "@yangxj96/logicflow-plugin-flowable/style.css": ["../logicflow-plugin-flowable/dist/index.css"]
        },
        "composite": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
    }
}
